ANTHROPIC_API_KEY=

# Only needed to run `hermes-telegram` (see README's Telegram section).
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated Telegram chat IDs allowed to message the bot.
# Leave unset to allow anyone who finds your bot to message it.
TELEGRAM_ALLOWED_CHAT_IDS=

# Only needed to run `hermes-whatsapp` (see README's WhatsApp section).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional: comma-separated list of E.164 numbers (no leading +) allowed to
# message the bot, e.g. 919876543210. Leave unset to allow any sender that
# can reach your webhook (fine for a Meta test number, since only approved
# testers can message it).
WHATSAPP_ALLOWED_NUMBERS=
PORT=8000
